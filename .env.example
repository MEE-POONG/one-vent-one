# MongoDB requires a replica set; npm run db:dev starts a persistent local one.
DATABASE_URL="mongodb://127.0.0.1:27018/oneventone?replicaSet=rs0&directConnection=true"
BETTER_AUTH_URL="http://127.0.0.1:3000"
# Extra origins allowed to sign in (comma separated), e.g. "http://192.168.1.20:3000".
# In development localhost and 127.0.0.1 of BETTER_AUTH_URL are both accepted automatically.
TRUSTED_ORIGINS=""
# Generate each secret independently with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
BETTER_AUTH_SECRET=""
TICKET_ENCRYPTION_KEY=""
JOB_SECRET=""
STORAGE_DIRECTORY=".local/uploads"
# Only set true when the production storage volume is persistent and privately accessible.
STORAGE_PERSISTENT="false"
# Set only behind a trusted proxy which replaces this header and is the sole ingress.
TRUSTED_CLIENT_IP_HEADER=""
# Only for the explicit admin:create command; remove after use.
BOOTSTRAP_ADMIN_EMAIL=""
BOOTSTRAP_ADMIN_PASSWORD=""
BOOTSTRAP_ADMIN_NAME="ผู้ดูแล OneVentOne"
