{
  "name": "oneventone",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "prisma generate && next build",
    "start": "next start --hostname 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "db:validate": "prisma validate",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:seed": "tsx prisma/seed.ts",
    "db:seed:events": "tsx prisma/seed-events.ts",
    "db:dev": "tsx scripts/dev-db.ts",
    "admin:create": "tsx scripts/bootstrap-admin.ts",
    "test": "node --conditions=react-server --import tsx --test tests/*.test.ts",
    "setup:local": "tsx scripts/setup-local.ts"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@better-auth/prisma-adapter": "1.7.19",
    "@fontsource-variable/noto-sans-thai": "5.3.0",
    "@prisma/client": "6.19.3",
    "better-auth": "1.7.19",
    "dotenv": "18.0.10",
    "html5-qrcode": "2.3.8",
    "konva": "10.9.1",
    "lucide-react": "1.71.0",
    "next": "16.4.6",
    "qrcode.react": "4.2.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-konva": "19.3.2",
    "server-only": "0.0.1",
    "sharp": "0.35.5",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.65.0",
    "@tailwindcss/postcss": "4.3.5",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.6",
    "mongodb-memory-server": "11.3.0",
    "prettier": "3.9.10",
    "prisma": "6.19.3",
    "tailwindcss": "4.3.5",
    "tsx": "4.23.15",
    "typescript": "6.0.3"
  }
}
